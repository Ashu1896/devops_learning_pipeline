# =========================================================================
# DEVOPS LEARNING PIPELINE - CONFIGURATION TEMPLATE
# =========================================================================

# 1. AI API Configuration (Choose at least one, Google Gemini recommended for free tier)
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key

# (Optional fallback) OpenAI key
OPENAI_API_KEY=

# 2. Git Integration
# Set to 'true' to push changes automatically after generation. 
# Defaults to 'true' if unset. Set to 'false' to commit locally only.
GIT_REMOTE_PUSH=false
